#!/usr/bin/env python3
from pymatgen.io.vasp import Vasprun
from vasputils.decorator import process_vasprun_decorator


@process_vasprun_decorator("Get total energy")
def main(vasprun: Vasprun):
    nelectrons = vasprun.parameters["NELECT"]
    print(f"Number of electrons: {nelectrons}")


if __name__ == "__main__":
    main()
