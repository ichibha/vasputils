#!/usr/bin/env python3

import argparse
import sys
from pathlib import Path

from pymatgen.analysis.structure_matcher import StructureMatcher
from pymatgen.core.structure import Structure
from pymatgen.io.vasp import Poscar


def main():
    # コマンド引数を定義
    parser = argparse.ArgumentParser(
        description="convert given poscar to primitive cell poscar"
    )
    parser.add_argument("poscar_path", type=str, help="POSCAR path")
    parser.add_argument(
        "--tolerance",
        type=float,
        help="Tolerance for each coordinate of a particular site in Angstroms in finding the pritimive cell.",
    )

    # コマンド引数を読み込み
    args = vars(parser.parse_args())
    poscar_path = Path(args.get("poscar_path"))
    tolerance: float = args.get("tolerance")

    # POSCARから構造を取得
    structure = Structure.from_file(poscar_path)

    # 構造を単位胞に変換
    kwargs = {}
    if tolerance is not None:
        kwargs["tolerance"] = tolerance

    primitive_structure = structure.get_primitive_structure(**kwargs)

    matcher = StructureMatcher(primitive_cell=False, attempt_supercell=False)
    if matcher.fit(structure, primitive_structure):
        # 所与の構造が既に単位胞である旨を表示
        print(f"{poscar_path.name} is already primitive cell.", file=sys.stderr)
        return

    # 単位胞をPOSCAR形式で標準出力
    print(Poscar(primitive_structure))


if __name__ == "__main__":
    main()
