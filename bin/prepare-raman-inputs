#!/usr/bin/env python3
import argparse
import os
import re
from glob import glob

from vasputils import prepare_vasp_input


def main():
    parser = argparse.ArgumentParser(
        description="prepare input files for harmonic forces calculations"
    )
    parser.add_argument(
        "--incar",
        type=str,
        required=True,
        help="INCAR filepath",
    )
    parser.add_argument(
        "--potcar",
        type=str,
        required=True,
        help="POTCAR filepath",
    )
    parser.add_argument(
        "--kpoints",
        type=str,
        required=True,
        help="KPOINTS filepath",
    )
    parser.add_argument(
        "--wavecar",
        type=str,
        help="WAVECAR filepath",
    )
    parser.add_argument(
        "--directory",
        type=str,
        default="./",
        help="root directory of phonon calculation",
    )
    parser.add_argument(
        "--use-softlink",
        action="store_true",
        help="prepare inputs by softlink rather than copy",
    )
    args = parser.parse_args()
    incar: str = args.incar
    potcar: str = args.potcar
    kpoints: str = args.kpoints
    wavecar: str = args.wavecar
    root_directory: str = args.directory
    use_softlink: bool = args.use_softlink

    for poscar in sorted(glob(os.path.join(root_directory, "Raman-POSCAR.*.*.vasp"))):
        dirname = os.path.basename(poscar).replace("POSCAR.", "").replace(".vasp", "")
        directory = os.path.join(root_directory, dirname)
        prepare_vasp_input(
            directory=directory,
            incar=incar,
            poscar=poscar,
            potcar=potcar,
            kpoints=kpoints,
            wavecar=wavecar,
            use_softlink=use_softlink,
        )


if __name__ == "__main__":
    main()
