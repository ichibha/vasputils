#!/usr/bin/env python3
import argparse
import os
import re
import subprocess
from glob import glob

from pymatgen.io.vasp.outputs import Vasprun


def get_directories(kind: str, root_directory: str):
    if kind in ["phonopy", "phono3py-fc2"]:
        pattern = r".*/FC2-\d+$"
    elif kind == "phono3py-fc3":
        pattern = r".*/FC3-\d+$"
    else:
        raise ValueError(f"Invalid kind value: {kind}")

    directories = sorted(
        directory
        for directory in glob(os.path.join(root_directory, "*"))
        if re.match(pattern, directory)
    )

    if directories:
        return directories
    else:
        raise FileNotFoundError(
            f"{kind} displacement directories are not found at {root_directory}."
        )


def get_command(kind: str):
    if kind == "phonopy":
        return ["phonopy", "-f"]
    elif kind == "phono3py-fc2":
        return ["phono3py", "--cf2"]
    elif kind == "phono3py-fc3":
        return ["phono3py", "--cf3"]
    else:
        raise ValueError(f"Invalid kind value: {kind}")


def main():
    # コマンド引数を定義
    parser = argparse.ArgumentParser(
        description=" FORCE_SETS with vasprun.xml for harmonic phonon calculation"
    )
    parser.add_argument(
        "directory",
        type=str,
        nargs="?",
        default="./",
        help="root directory of phonon calculation",
    )
    parser.add_argument(
        "--kind",
        type=str,
        required=True,
        choices=["phonopy", "phono3py-fc2", "phono3py-fc3"],
    )

    # コマンド引数を読み込み
    args = vars(parser.parse_args())
    root_directory: str = args.get("directory")
    kind: str = args.get("kind")

    # 変位構造の計算ディレクトリを読み込み
    directories = get_directories(kind=kind, root_directory=root_directory)

    # vasprun.xmlパスを読み込み
    vasprun_paths: list[str] = []
    has_errors = False
    for directory in directories:
        vasprun_path = os.path.join(directory, "vasprun.xml")

        # vasprun.xmlを正しく読み込むことができるか検証
        try:
            vasprun = Vasprun(vasprun_path)
        except Exception as e:
            print(f"Cannot read {vasprun_path}: {e}")
            has_errors = True
            continue

        # 収束を確認
        if not vasprun.converged:
            print(f"Not converged: {vasprun_path}")
            has_errors = True
            continue

        vasprun_paths.append(vasprun_path)

    if has_errors:
        return

    subprocess.run(get_command(kind=kind) + vasprun_paths)


if __name__ == "__main__":
    main()
