#!/usr/bin/env python3
import argparse
import os
import re
import shutil
import sys
from glob import glob

from vasputils import prepare_vasp_input


def main():
    parser = argparse.ArgumentParser(
        description="prepare input files for displaced structures for harmonic phoonon calculations"
    )
    parser.add_argument(
        "--incar",
        type=str,
        required=True,
        help="INCAR filepath",
    )
    parser.add_argument(
        "--potcar",
        type=str,
        required=True,
        help="POTCAR filepath",
    )
    parser.add_argument(
        "--kpoints-fc2",
        type=str,
        required=True,
        help="KPOINTS filepath for FC2",
    )
    parser.add_argument(
        "--kpoints-fc3",
        type=str,
        required=True,
        help="KPOINTS filepath for FC3",
    )
    parser.add_argument(
        "--wavecar-fc2",
        type=str,
        help="WAVECAR filepath for FC2",
    )
    parser.add_argument(
        "--wavecar-fc3",
        type=str,
        help="WAVECAR filepath for FC3",
    )
    parser.add_argument(
        "--directory",
        type=str,
        default="./",
        help="root directory of phonon calculation",
    )
    parser.add_argument(
        "--use-softlink",
        action="store_true",
        help="prepare inputs by softlink rather than copy",
    )
    args = parser.parse_args()
    incar: str = args.incar
    potcar: str = args.potcar
    kpoints_fc2: str = args.kpoints_fc2
    kpoints_fc3: str = args.kpoints_fc3
    wavecar_fc2: str = args.wavecar_fc2
    wavecar_fc3: str = args.wavecar_fc3
    root_directory: str = args.directory
    use_softlink: bool = args.use_softlink

    # FC2の計算
    for poscar in sorted(glob(os.path.join(root_directory, "POSCAR_FC2-*"))):
        basename = os.path.basename(poscar)
        if not re.match(r"^POSCAR_FC2-[0-9]+$", basename):
            continue
        directory = os.path.join(root_directory, basename.replace("POSCAR_", ""))
        prepare_vasp_input(
            directory=directory,
            incar=incar,
            poscar=poscar,
            potcar=potcar,
            kpoints=kpoints_fc2,
            wavecar=wavecar_fc2,
            use_softlink=use_softlink,
        )

    # FC3の計算
    for poscar in sorted(glob(os.path.join(root_directory, "POSCAR-*"))):
        basename = os.path.basename(poscar)
        if not re.match(r"^POSCAR-[0-9]+$", basename):
            continue
        directory = os.path.join(root_directory, basename.replace("POSCAR-", "FC3-"))
        prepare_vasp_input(
            directory=directory,
            incar=incar,
            poscar=poscar,
            potcar=potcar,
            kpoints=kpoints_fc3,
            wavecar=wavecar_fc3,
            use_softlink=use_softlink,
        )


if __name__ == "__main__":
    main()
