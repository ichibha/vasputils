#!/usr/bin/env python3
import argparse
import os
import re
import shutil
from glob import glob

RUN_TEMPLATE = """
#!/usr/bin/env bash

for directory in DIRECTORIES; do
	# 微小変位構造の計算ディレクトリに移動
	cd $directory

	if [ -f OUTCAR ] && grep -q "EDIFF is reached" OUTCAR; then
		# 計算が完了しているならば、何もしない
		echo "$directory: already converged."
	else
		# 計算が完了していないならば、VASPを実行する
		mpirun vasp_std | tee vasp.out
	fi

	# 直前にいたディレクトリに移動する / 移動先を画面出力する
	cd -
done
"""


def get_poscar_paths(kind: str, root_directory: str):
    pattern = {
        "phonopy": "POSCAR-*",
        "phono3py-fc2": "POSCAR_FC2-*",
        "phono3py-fc3": "POSCAR-*",
        "raman": "Raman-POSCAR.*.*.vasp",
    }.get(kind)

    if not pattern:
        raise ValueError(f"Invalide kind value: {kind}")

    poscar_paths = sorted(glob(os.path.join(root_directory, pattern)))

    if poscar_paths:
        return poscar_paths
    else:
        raise FileNotFoundError(
            f"{kind} displacement poscars are not found at {root_directory}."
        )


def get_dirname(kind: str, poscar_path: str):
    basename = os.path.basename(poscar_path)
    if kind in ["phonopy", "phono3py-fc3"]:
        return basename.removeprefix("POSCAR-")
    elif kind == "phono3py-fc2":
        return basename.removeprefix("POSCAR_FC2-")
    elif kind == "raman":
        return basename.removeprefix("Raman-POSCAR.").removesuffix(".vasp")
    else:
        raise ValueError(f"Invalid kind value: {kind}")


def get_run_script_name(kind: str):
    script_name = {
        "phonopy": "run.sh",
        "phono3py-fc2": "run_fc2.sh",
        "phono3py-fc3": "run_fc3.sh",
        "raman": "run_raman.sh",
    }.get(kind)

    if script_name:
        return script_name
    else:
        raise ValueError(f"Invalid kind value: {kind}")


def prepare_vasp_input(
    directory: str,
    incar: str,
    poscar: str,
    potcar: str,
    kpoints: str,
    wavecar: str = None,
    softlink: bool = False,
):
    try:
        os.makedirs(directory)
    except Exception as e:
        raise RuntimeError(f"Failed to create {directory}:", e)

    copy = os.symlink if softlink else shutil.copy
    copy(os.path.abspath(poscar), os.path.join(directory, "POSCAR"))
    copy(os.path.abspath(incar), os.path.join(directory, "INCAR"))
    copy(os.path.abspath(potcar), os.path.join(directory, "POTCAR"))
    if kpoints:
        copy(os.path.abspath(kpoints), os.path.join(directory, "KPOINTS"))
    if wavecar:
        copy(os.path.abspath(wavecar), os.path.join(directory, "WAVECAR"))


def main():
    # コマンド引数を定義
    parser = argparse.ArgumentParser(description="prepare vasp-phonon input files")
    parser.add_argument(
        "--kind",
        type=str,
        required=True,
        choices=["phonopy", "phono3py-fc2", "phono3py-fc3", "raman"],
    )
    parser.add_argument(
        "--incar",
        type=str,
        required=True,
        help="INCAR filepath",
    )
    parser.add_argument(
        "--potcar",
        type=str,
        required=True,
        help="POTCAR filepath",
    )
    parser.add_argument(
        "--kpoints",
        type=str,
        help="KPOINTS filepath",
    )
    parser.add_argument(
        "--wavecar",
        type=str,
        help="WAVECAR filepath",
    )
    parser.add_argument(
        "--directory",
        type=str,
        default="./",
        help="root directory of phonon calculation",
    )
    parser.add_argument(
        "--softlink",
        action="store_true",
        help="prepare inputs by softlink rather than copy",
    )

    # コマンド引数を取得
    args = vars(parser.parse_args())
    kind: str = args.get("kind")
    incar: str = args.get("incar")
    potcar: str = args.get("potcar")
    kpoints: str = args.get("kpoints")
    wavecar: str = args.get("wavecar")
    root_directory: str = args.get("directory")
    softlink: bool = args.get("softlink")

    dirnames: list[str] = []
    for poscar_path in get_poscar_paths(kind=kind, root_directory=root_directory):
        dirname = get_dirname(kind=kind, poscar_path=poscar_path)
        prepare_vasp_input(
            directory=os.path.join(root_directory, dirname),
            incar=incar,
            poscar=poscar_path,
            potcar=potcar,
            kpoints=kpoints,
            wavecar=wavecar,
            softlink=softlink,
        )
        dirnames.append(dirname)

    with open(
        os.path.join(root_directory, get_run_script_name(kind=kind)), "w"
    ) as fout:
        fout.write(RUN_TEMPLATE.replace("DIRECTORIES", " ".join(dirnames)))


if __name__ == "__main__":
    main()
