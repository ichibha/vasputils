#!/usr/bin/env python3
import argparse
import os
import shutil
from glob import glob


def get_pattern(kind: str):
    pattern_dict = {
        "phonopy": "POSCAR-*",
        "phono3py-fc2": "POSCAR_FC2-*",
        "phono3py-fc3": "POSCAR-*",
        "raman": "Raman-POSCAR.*.*.vasp",
    }
    return pattern_dict.get(kind)


def get_dirname(poscar: str, kind: str):
    basename = os.path.basename(poscar)
    if kind == "phonopy":
        return basename.replace("POSCAR", "FC2")
    elif kind == "phono3py-fc2":
        return basename.replace("POSCAR_", "")
    elif kind == "phono3py-fc3":
        return basename.replace("POSCAR", "FC3")
    elif kind == "raman":
        return basename.replace("POSCAR.", "").rstrip(".vasp")
    else:
        return None


def prepare_vasp_input(
    directory: str,
    incar: str,
    poscar: str,
    potcar: str,
    kpoints: str,
    wavecar: str = None,
    softlink: bool = False,
):
    try:
        os.makedirs(directory)
    except Exception as e:
        raise Exception(f"Failed to create {directory}:", e)
    copy = os.symlink if softlink else shutil.copy
    copy(os.path.abspath(poscar), os.path.join(directory, "POSCAR"))
    copy(os.path.abspath(incar), os.path.join(directory, "INCAR"))
    copy(os.path.abspath(potcar), os.path.join(directory, "POTCAR"))
    if kpoints:
        copy(os.path.abspath(kpoints), os.path.join(directory, "KPOINTS"))
    if wavecar:
        copy(os.path.abspath(wavecar), os.path.join(directory, "WAVECAR"))


def main():
    parser = argparse.ArgumentParser(description="prepare vasp-phonon input files")
    parser.add_argument(
        "--kind",
        type=str,
        required=True,
        choices=["phonopy", "phono3py-fc2", "phono3py-fc3", "raman"],
    )
    parser.add_argument(
        "--incar",
        type=str,
        required=True,
        help="INCAR filepath",
    )
    parser.add_argument(
        "--potcar",
        type=str,
        required=True,
        help="POTCAR filepath",
    )
    parser.add_argument(
        "--kpoints",
        type=str,
        help="KPOINTS filepath",
    )
    parser.add_argument(
        "--wavecar",
        type=str,
        help="WAVECAR filepath",
    )
    parser.add_argument(
        "--directory",
        type=str,
        default="./",
        help="root directory of phonon calculation",
    )
    parser.add_argument(
        "--softlink",
        action="store_true",
        help="prepare inputs by softlink rather than copy",
    )

    args = parser.parse_args()
    kind: str = args.kind
    incar: str = args.incar
    potcar: str = args.potcar
    kpoints: str = args.kpoints
    wavecar: str = args.wavecar
    root_directory: str = args.directory
    softlink: bool = args.softlink

    pattern = get_pattern(kind)
    if not pattern:
        print(f"Error: kind={kind} not defined.")
        parser.print_help()

    for poscar in sorted(glob(os.path.join(root_directory, pattern))):
        directory = os.path.join(root_directory, get_dirname(poscar, kind))
        prepare_vasp_input(
            directory=directory,
            incar=incar,
            poscar=poscar,
            potcar=potcar,
            kpoints=kpoints,
            wavecar=wavecar,
            softlink=softlink,
        )


if __name__ == "__main__":
    main()
