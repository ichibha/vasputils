#!/usr/bin/env python3
import argparse
from pathlib import Path

from pymatgen.io.vasp import Vasprun


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+", help="vasprun.xml paths")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        vasprun = Vasprun(vasprun_path)
        bandgap = vasprun.complete_dos.get_gap()
        print(f"{vasprun_path}: {bandgap:.8f} eV")


if __name__ == "__main__":
    main()
