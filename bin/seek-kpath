#!/usr/bin/env python3
import argparse
from fractions import Fraction

from pymatgen.core import Structure
from pymatgen.symmetry.bandstructure import HighSymmKpath


def main():
    # コマンド引数
    parser = argparse.ArgumentParser(description="seek kpath for band plot")
    parser.add_argument("poscar_path", type=str, help="POSCAR path")
    parser.add_argument("--vasp", action="store_true")
    parser.add_argument("--phonopy", action="store_true")
    parser.add_argument("--intervals", type=int, default=20)

    args = vars(parser.parse_args())
    num_intervals: int = args.get("intervals")
    poscar_path: str = args.get("poscar_path")
    use_vasp: bool = args.get("vasp")
    use_phonopy: bool = args.get("phonopy")

    if not any([use_vasp, use_phonopy]):
        print("Error: Specify --vasp or --phonopy")
        return

    # POSCARからHighSymmKpathインスタンスを初期化
    structure = Structure.from_file(poscar_path)
    kpath = HighSymmKpath(structure)

    # 高対称点のラベルと座標を取得
    kpoints: dict = kpath.kpath["kpoints"]
    labels: list[str] = list(kpoints.keys())
    points: list[list[float]] = list(map(list, kpoints.values()))

    # KPOINTS形式で出力
    if use_vasp:
        labels = [l.removeprefix("\\") for l in labels]
        points = [[f"{x:.10f}" for x in p] for p in points]
        print("K-Path Generated by vasputils.")
        print(f"   {num_intervals}")
        print("Line-Mode")
        print("Reciprocal")
        for i in range(len(labels) - 1):
            print(" ".join(points[i] + [labels[i]]))
            print(" ".join(points[i + 1] + [labels[i + 1]]))
            print()

    # mesh.conf形式で出力
    if use_phonopy:
        labels = [f"${l}$" if "\\" in l else l for l in labels]
        points = [[str(Fraction(x).limit_denominator(8)) for x in p] for p in points]
        print("BAND_LABELS = " + " ".join(labels))
        print("BAND = " + "   ".join(" ".join(list(point)) for point in points))


if __name__ == "__main__":
    main()
