#!/usr/bin/env python3
import argparse
from fractions import Fraction
from pathlib import Path

from pymatgen.core import Structure
from pymatgen.symmetry.bandstructure import HighSymmKpath


def main():
    parser = argparse.ArgumentParser(description="seek kpath for band plot")
    parser.add_argument("poscar_path", type=str, help="POSCAR path")
    parser.add_argument("--intervals", type=int)
    group = parser.add_mutually_exclusive_group(required=False)
    group.add_argument("--vasp", dest="format", action="store_const", const="vasp")
    group.add_argument(
        "--phonopy", dest="format", action="store_const", const="phonopy"
    )
    parser.set_defaults(format="vasp")

    args = parser.parse_args()
    poscar_path = Path(args.poscar_path)
    num_intervals = args.intervals
    output_format = args.format

    if output_format == "vasp":
        print_kpath_for_vasp(poscar_path, num_intervals)
    elif output_format == "phonopy":
        print_kpath_for_phonopy(poscar_path, num_intervals)
    else:
        raise ValueError(f"Format {output_format} undefined.")


def print_kpath_for_vasp(poscar_path: Path, num_intervals: int | None):
    labels, points = get_labels_and_points(poscar_path)
    num_intervals = num_intervals or 20

    labels = [l.removeprefix("\\") for l in labels]
    points = [[f"{x:.10f}" for x in p] for p in points]

    print("K-Path Generated by vasputils.")
    print(num_intervals)
    print("Line-Mode")
    print("Reciprocal")
    for i in range(len(labels) - 1):
        print(" ".join(points[i] + [labels[i]]))
        print(" ".join(points[i + 1] + [labels[i + 1]]))
        print()


def print_kpath_for_phonopy(poscar_path: Path, num_intervals: int | None):
    labels, points = get_labels_and_points(poscar_path)
    num_intervals = num_intervals or 51

    labels = [f"${l}$" if "\\" in l else l for l in labels]
    points = [[str(Fraction(x).limit_denominator(8)) for x in p] for p in points]

    print(f"BAND_POINTS = {num_intervals}")
    print("BAND_LABELS = " + " ".join(labels))
    print("BAND = " + "   ".join(" ".join(list(point)) for point in points))


def get_labels_and_points(poscar_path: Path):
    # POSCARからHighSymmKpathインスタンスを初期化
    structure = Structure.from_file(poscar_path)
    kpath = HighSymmKpath(structure)

    # 高対称点のラベルと座標を取得
    kpoints: dict = kpath.kpath["kpoints"]
    labels: list[str] = list(kpoints.keys())
    points: list[list[float]] = list(map(list, kpoints.values()))

    return labels, points


if __name__ == "__main__":
    main()
