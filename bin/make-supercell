#!/usr/bin/env python3
import argparse

import numpy as np
from pymatgen.core import Structure
from pymatgen.io.vasp import Poscar


def main():
    # コマンド引数を定義
    parser = argparse.ArgumentParser()
    parser.add_argument("poscar_path", type=str)
    parser.add_argument(
        "--size", type=int, nargs=3, required=True, metavar=("a", "b", "c")
    )

    # コマンド引数を取得
    args = vars(parser.parse_args())
    poscar_path: str = args.get("poscar_path")
    size: tuple[int, int, int] = args.get("size")

    # スーパーセルを生成
    structure = Structure.from_file(poscar_path)
    super_structure = structure.make_supercell(np.diag(size), in_place=False)

    # スーパーセルをPOSCAR形式で表示
    print(Poscar(super_structure))


if __name__ == "__main__":
    main()
