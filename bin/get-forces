#!/usr/bin/env python3
import argparse
from pathlib import Path

from vasputils import get_forces, get_maximum_force_magnitude


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_path", type=str, help="vasprun.xml path")
    args = vars(parser.parse_args())
    vasprun_path = Path(args.get("vasprun_path"))

    forces = get_forces(vasprun_path)
    for i, force in enumerate(forces):
        print(f"{i+1:3}: {force[0]:+.3e}  {force[1]:+.3e}  {force[2]:+.3e}")

    index, magnitude = get_maximum_force_magnitude(vasprun_path)
    print(f"Atom {index+1} has the largest force magnitude {magnitude} eV/A")


if __name__ == "__main__":
    main()
