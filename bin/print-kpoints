#!/usr/bin/env python3
import argparse
from pathlib import Path

from pymatgen.io.vasp import Vasprun


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+", help="vasprun.xml paths")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        vasprun = Vasprun(
            vasprun_path,
            parse_dos=False,
            parse_eigen=False,
            parse_projected_eigen=False,
            parse_potcar_file=False,
        )
        print(vasprun.kpoints)


if __name__ == "__main__":
    main()
