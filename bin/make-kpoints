#!/usr/bin/env python3
import argparse
import sys

from pymatgen.io.vasp.inputs import Kpoints


def main():
    parser = argparse.ArgumentParser(description="make KPOINTS with automatic mesh")
    parser.add_argument(
        "--gamma",
        nargs=3,
        type=int,
        help="gamma mesh (e.g., --gamma 4 4 4)",
    )
    parser.add_argument(
        "--mp",
        nargs=3,
        type=int,
        help="monkhost pack mesh (e.g., --mp 4 4 4)",
    )
    args = parser.parse_args()
    gamma: tuple[int, int, int] = args.gamma
    mp: tuple[int, int, int] = args.mp

    if gamma and not mp:
        print(f"Writing gamma mesh {gamma[0]}x{gamma[1]}x{gamma[2]} into KPOINTS ... ")
        kpoints = Kpoints.gamma_automatic(gamma)
        kpoints.write_file("KPOINTS")
    elif mp and not gamma:
        print(f"Writing mp mesh {gamma[0]}x{gamma[1]}x{gamma[2]} into KPOINTS ... ")
        kpoints = Kpoints.monkhorst_automatic(mp)
        kpoints.write_file("KPOINTS")
    else:
        print("Provide either --gamma or --mp.")
        print("Exiting ...")
        sys.exit(1)


if __name__ == "__main__":
    main()
