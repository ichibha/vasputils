#!/usr/bin/env python3
import argparse

from pymatgen.io.vasp.inputs import Kpoints


def main():
    # コマンド引数を定義
    parser = argparse.ArgumentParser()
    parser.add_argument("mesh", type=int, nargs=3)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--gamma", action="store_true")
    group.add_argument("--mp", "--monkhorst", action="store_true")

    # コマンド引数を読み込み
    args = vars(parser.parse_args())
    mesh: tuple[int, int, int] = args.get("mesh")
    gamma: bool = args.get("gamma")
    mp: bool = args.get("mp")

    # KPOINTSを生成
    if gamma:
        kpoints = Kpoints.gamma_automatic(mesh)
    elif mp:
        kpoints = Kpoints.monkhorst_automatic(mesh)

    # KPOINTSを表示
    print(kpoints)


if __name__ == "__main__":
    main()
