#!/usr/bin/env python3

import argparse
import os
import sys

from pymatgen.core.structure import Structure
from pymatgen.io.vasp import Poscar
from pymatgen.symmetry.analyzer import SpacegroupAnalyzer


def main():
    # オプション引数を読み込む
    parser = argparse.ArgumentParser(
        description="convert given poscar to conventional cell poscar"
    )
    parser.add_argument("poscar_path", type=str, help="POSCAR filepath")
    parser.add_argument(
        "--tolerance",
        type=float,
        default=0.25,
        help="tolerance for finding the conventional cell (default: 0.25)",
    )
    args = parser.parse_args()
    poscar_path: str = args.poscar_path
    tolerance: float = args.tolerance

    # コンベンショナル
    structure = Structure.from_file(poscar_path)
    sga = SpacegroupAnalyzer(structure, symprec=tolerance)
    conventional_structure = sga.get_conventional_standard_structure()

    # poscarファイルとして保存する
    poscar = Poscar(conventional_structure)
    base, ext = os.path.splitext(os.path.basename(poscar_path))
    output_path = f"{base}_conv{ext}"
    print(f"Writing out conventional structure to {output_path} ...")
    poscar.write_file(output_path)


if __name__ == "__main__":
    main()
