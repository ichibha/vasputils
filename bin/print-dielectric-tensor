#!/usr/bin/env python3
import argparse
import xml.etree.ElementTree as ET
from pathlib import Path

from pymatgen.io.vasp import Vasprun


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+", help="vasprun.xml paths")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        print(vasprun_path)
        print_dielectric_tensor(vasprun_path)
        print()


def print_dielectric_tensor(vasprun_path):
    vasprun = Vasprun(vasprun_path)
    epsilon = vasprun.epsilon_static
    for i in range(3):
        for j in range(3):
            print(f"  {epsilon[i][j]:+.6f}", end=" ")
        print()


if __name__ == "__main__":
    main()
