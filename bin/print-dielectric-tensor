#!/usr/bin/env python3
import argparse

from pymatgen.io.vasp import Vasprun

from vasputils import (
    add_vasprun_paths_argument,
    cast_vasprun_paths,
    get_status,
    is_converged,
)


def main():
    parser = argparse.ArgumentParser()
    add_vasprun_paths_argument(parser)
    args = vars(parser.parse_args())
    vasprun_paths = cast_vasprun_paths(args.get("vasprun_paths"))

    for vasprun_path in vasprun_paths:
        print(f"{vasprun_path}:")
        if is_converged(vasprun_path):
            print_dielectric_tensor(vasprun_path)
        else:
            print(get_status(vasprun_path))
        print()


def print_dielectric_tensor(vasprun_path):
    vasprun = Vasprun(vasprun_path)
    epsilon = vasprun.epsilon_static
    for i in range(3):
        for j in range(3):
            print(f"  {epsilon[i][j]:+.6f}", end=" ")
        print()


if __name__ == "__main__":
    main()
