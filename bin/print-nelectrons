#!/usr/bin/env python3
import argparse
from pathlib import Path

from pymatgen.io.vasp import Vasprun

from vasputils import get_status, is_converged


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        print(vasprun_path, end=": ")
        if is_converged(vasprun_path):
            vasprun = Vasprun(vasprun_path)
            nelectrons = vasprun.parameters["NELECT"]
            print(f"{nelectrons}")
        else:
            print(get_status(vasprun_path))


if __name__ == "__main__":
    main()
