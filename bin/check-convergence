#!/usr/bin/env python3
import argparse

from vasputils import add_vasprun_paths_argument, cast_vasprun_paths, get_status


def main():
    parser = argparse.ArgumentParser()
    add_vasprun_paths_argument(parser)
    args = vars(parser.parse_args())
    vasprun_paths = cast_vasprun_paths(args.get("vasprun_paths"))

    for vasprun_path in vasprun_paths:
        print(f"{vasprun_path}: {get_status(vasprun_path)}")


if __name__ == "__main__":
    main()
