#!/usr/bin/env python3
import argparse
from pathlib import Path

from vasputils import get_status


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        print(f"{vasprun_path}: {get_status(vasprun_path)}")


if __name__ == "__main__":
    main()
