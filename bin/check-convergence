#!/usr/bin/env python3
from pymatgen.io.vasp import Vasprun
from vasputils.decorator import process_vasprun_decorator


@process_vasprun_decorator("Check convergence")
def main(vasprun: Vasprun):
    print(f"SCF steps converged: {vasprun.converged_electronic}")
    print(f"Ionic steps converged: {vasprun.converged_ionic}")


if __name__ == "__main__":
    main()
