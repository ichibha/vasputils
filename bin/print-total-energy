#!/usr/bin/env python3
import argparse
from pathlib import Path

from vasputils import get_fu, get_status, get_total_energy, is_converged


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vasprun_paths", type=str, nargs="+", help="vasprun.xml paths")
    args = vars(parser.parse_args())
    vasprun_paths = list(map(Path, args.get("vasprun_paths")))

    for vasprun_path in vasprun_paths:
        print(vasprun_path, end=": ")
        if is_converged(vasprun_path):
            total_energy = get_total_energy(vasprun_path)
            total_energy_per_fu = total_energy / get_fu(vasprun_path)
            print(f"{total_energy:.8f} eV, {total_energy_per_fu:.8f} eV/fu")
        else:
            print(get_status(vasprun_path))


if __name__ == "__main__":
    main()
